load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("//tests:adapter_action.bzl", "adapter_action")
load("//tests:argv.bzl", "alias_data", "argv_record_test", "two_actions")
load("//tests:param_action.bzl", "param_action")
load("//tests:tools_action.bzl", "tools_action")
load("//tests:verify_test.bzl", "runtime_contract_test")
load("//wine:windows_binary.bzl", "windows_binary")
load("//wine:windows_run.bzl", "windows_run")
load("//wine:windows_test.bzl", "windows_test")

cc_binary(
    name = "companion_build",
    testonly = True,
    srcs = ["fixture/companion.c"],
    linkopts = ["-Wl,--no-insert-timestamp"],
    linkshared = True,
)

cc_binary(
    name = "fixture_build",
    testonly = True,
    srcs = ["fixture/main.cc"],
    copts = [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    linkopts = ["-lshell32"],
)

cc_binary(
    name = "verify_build",
    testonly = True,
    srcs = ["verify/main.cc"],
    copts = [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    deps = ["//wine/runtime:json"],
)

test_suite(
    name = "integration",
    tests = [
        "adapter_cli_test",
        "argv_test",
        "external_location_test",
        "generated_location_test",
        "payload_layout_test",
        "runfiles_test",
        "runtime_contract_test",
        "smoke_test",
    ],
)

cc_binary(
    name = "argv_verify",
    testonly = True,
    srcs = ["argv_verify.cc"],
    copts = [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    deps = ["//wine/runtime:json"],
)

cc_binary(
    name = "runfiles_fixture",
    testonly = True,
    srcs = ["runfiles_fixture.cc"],
    copts = [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    data = ["@rules_cc//:LICENSE"],
    deps = ["@rules_cc//cc/runfiles"],
)

windows_run(
    name = "standard_runfiles",
    testonly = True,
    outs = ["standard-runfiles.json"],
    arch = "x86_64",
    arguments = ["$@"],
    binary = "runfiles_fixture",
    data = ["aliases"],
    target_platform = "@llvm//platforms:windows_x86_64",
)

filegroup(
    name = "two_files",
    srcs = [
        "data/a",
        "data/b",
    ],
)

alias_data(
    name = "aliases",
    src = "data/alias-only.txt",
)

windows_run(
    name = "argv_action",
    srcs = [
        "data/a}b.txt",
        "data/cash$money.txt",
        "data/file name café.txt",
        "//:.bazelversion",
    ],
    outs = ["argv-action}.json"],
    arch = "x86_64",
    arguments = [
        "--output",
        "$@",
        "@$(location data/file name café.txt)",
        "@$(location data/cash$money.txt)",
        "@$(location data/a}b.txt)",
        "@$(location //:.bazelversion)",
        "$$literal",
        "$$(location data/a)",
        "",
        "$(locations two_files)",
        "opaque/option:one/two",
        "café",
        "@$(runfile root-alias.txt)",
        "@$(runfile _main/logical/data.txt)",
    ],
    binary = "fixture/fixture_x86_64.exe",
    data = [
        "aliases",
        "data/a tests/data/b",
        "two_files",
    ],
)

windows_binary(
    name = "argv_binary",
    arch = "x86_64",
    arguments = [
        "@$(location data/file name café.txt)",
        "@$(location data/cash$money.txt)",
        "@$(location data/a}b.txt)",
        "@$(location //:.bazelversion)",
        "$$literal",
        "$$(location data/a)",
        "",
        "$(locations two_files)",
        "opaque/option:one/two",
        "café",
        "@$(runfile root-alias.txt)",
        "@$(runfile _main/logical/data.txt)",
    ],
    binary = "fixture/fixture_x86_64.exe",
    data = [
        "aliases",
        "data/a tests/data/b",
        "data/a}b.txt",
        "data/cash$money.txt",
        "data/file name café.txt",
        "two_files",
        "//:.bazelversion",
    ],
)

adapter_action(
    name = "argv_adapter",
    tool = "argv_binary",
)

two_actions(
    name = "distinct_actions",
    binary = "fixture/fixture_x86_64.exe",
)

argv_record_test(
    name = "argv_test",
    records = {
        "standard_runfiles": json.encode([
            "mapped external",
            "alias-only data",
        ]),
        "argv_action": json.encode([
            "space and Unicode data",
            "literal dollar data",
            "brace data",
            "9.3.1",
            "$literal",
            "$(location data/a)",
            "",
            {"suffix": "tests\\data\\a"},
            {"suffix": "tests\\data\\b"},
            "opaque/option:one/two",
            "café",
            "alias-only data",
            "alias-only data",
        ]),
        "argv_adapter": json.encode([
            "space and Unicode data",
            "literal dollar data",
            "brace data",
            "9.3.1",
            "$literal",
            "$(location data/a)",
            "",
            {"suffix": "tests\\data\\a"},
            {"suffix": "tests\\data\\b"},
            "opaque/option:one/two",
            "café",
            "alias-only data",
            "alias-only data",
            "adapter-tool",
        ]),
    },
)

windows_run(
    name = "generate",
    outs = ["generated.json"],
    arch = "x86_64",
    arguments = [
        "--output",
        "$@",
        "space value",
        "",
        "Unicode: café",
        "--isolated",
    ],
    binary = "fixture/fixture_x86_64.exe",
)

windows_binary(
    name = "binary",
    arch = "x86_64",
    arguments = [
        "space value",
        "",
        "café",
    ],
    binary = "fixture/fixture_x86_64.exe",
)

windows_run(
    name = "transitioned",
    outs = ["transitioned.json"],
    arch = "x86_64",
    arguments = [
        "--output",
        "$@",
    ],
    binary = "fixture/fixture_x86_64.exe",
    target_platform = "//platforms:windows_x86_64",
)

windows_test(
    name = "smoke_test",
    arch = "x86_64",
    arguments = [
        "--contract",
        "with spaces",
        "",
        "café",
        "--isolated",
    ],
    binary = "fixture/fixture_x86_64.exe",
    env = {"FIXTURE_VALUE": "Unicode: café"},
    shard_count = 2,
)

adapter_action(
    name = "adapter_tool",
    tool = "binary",
)

windows_run(
    name = "dll",
    outs = ["dll.json"],
    arch = "x86_64",
    arguments = [
        "--dll",
        "--output",
        "$@",
    ],
    binary = "fixture/fixture_x86_64.exe",
    data = ["fixture/companion.dll"],
)

windows_run(
    name = "response",
    outs = ["response.json"],
    arch = "x86_64",
    arguments = [
        "--output",
        "$@",
        "@$(location fixture/response.txt)",
    ],
    binary = "fixture/fixture_x86_64.exe",
    data = ["fixture/response.txt"],
)

runtime_contract_test(
    name = "runtime_contract_test",
    size = "medium",
    timeout = "moderate",
    payload = "fixture/fixture_x86_64.exe",
    wrong_arch = "fixture/fixture_aarch64.exe",
)

exports_files(
    [
        "fixture/fixture_x86_64.exe",
        "fixture/fixture_aarch64.exe",
    ],
    visibility = ["//visibility:public"],
)

windows_test(
    name = "runfiles_test",
    arch = "x86_64",
    arguments = ["@$(location fixture/data café.txt)"],
    binary = "fixture/fixture_x86_64.exe",
    data = ["fixture/data café.txt"],
)

windows_test(
    name = "timeout_test",
    timeout = "short",
    arch = "x86_64",
    arguments = ["--sleep"],
    binary = "fixture/fixture_x86_64.exe",
    tags = ["manual"],
)

windows_run(
    name = "missing_dll",
    outs = ["missing-dll.json"],
    arch = "x86_64",
    arguments = [
        "--dll",
        "--output",
        "$@",
    ],
    binary = "fixture/fixture_x86_64.exe",
    tags = ["manual"],
)

windows_run(
    name = "generate_arm64",
    outs = ["arm64.json"],
    arch = "aarch64",
    arguments = [
        "--output",
        "$@",
    ],
    binary = "fixture/fixture_aarch64.exe",
    tags = ["manual"],
)

param_action(
    name = "param_file",
    binary = "fixture/fixture_x86_64.exe",
)

runtime_contract_test(
    name = "adapter_cli_test",
    timeout = "moderate",
    adapter_cli_only = True,
    payload = "fixture/fixture_x86_64.exe",
    wrong_arch = "fixture/fixture_aarch64.exe",
)

windows_binary(
    name = "additional_tool",
    arch = "x86_64",
    binary = "fixture/fixture_x86_64.exe",
    data = [
        "fixture/data café.txt",
        "@platforms//:LICENSE",
    ],
)

tools_action(
    name = "external_tools",
    additional_tools = True,
    binary = "fixture/fixture_x86_64.exe",
    extra = "additional_tool",
    extra_data = "@platforms//:LICENSE",
)

tools_action(
    name = "additional_tools",
    additional_tools = True,
    binary = "fixture/fixture_x86_64.exe",
    extra = "additional_tool",
)

tools_action(
    name = "default_group",
    binary = "fixture/fixture_x86_64.exe",
    default_group = True,
)

tools_action(
    name = "default_group_tools",
    additional_tools = True,
    binary = "fixture/fixture_x86_64.exe",
    default_group = True,
    extra = "additional_tool",
)

windows_test(
    name = "generated_location_test",
    arch = "x86_64",
    arguments = ["@$(location generate)"],
    binary = "fixture/fixture_x86_64.exe",
    data = ["generate"],
)

windows_test(
    name = "external_location_test",
    arch = "x86_64",
    arguments = ["@$(location @platforms//:LICENSE)"],
    binary = "fixture/fixture_x86_64.exe",
    data = ["@platforms//:LICENSE"],
)

windows_binary(
    name = "location_binary",
    arch = "x86_64",
    arguments = [
        "@$(location generate)",
        "@$(location @platforms//:LICENSE)",
        "$(location generate)",
    ],
    binary = "fixture/fixture_x86_64.exe",
    data = [
        "generate",
        "@platforms//:LICENSE",
    ],
)

adapter_action(
    name = "location_tool",
    tool = "location_binary",
)

runtime_contract_test(
    name = "payload_layout_test",
    timeout = "moderate",
    companion = "fixture/companion.dll",
    payload = "fixture/fixture_x86_64.exe",
    payload_layout = True,
    wrong_arch = "fixture/fixture_aarch64.exe",
)
