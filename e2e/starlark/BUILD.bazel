load("@rules_wine//wine:toolchain.bzl", "windows_runner_toolchain")
load("@rules_wine//wine:windows_binary.bzl", "windows_binary")
load(":audit.bzl", "collision", "stub", "symlink_data")

package(default_visibility = ["//visibility:public"])

platform(
    name = "audit_exec",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "audit_windows",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

windows_runner_toolchain(
    name = "native_implementation",
    arch = "x86_64",
    backend = "native",
)

toolchain(
    name = "native_runner",
    exec_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":native_implementation",
    toolchain_type = "@rules_wine//wine:runner_x86_64_toolchain_type",
)

stub(
    name = "launcher",
    data = ["launcher_data"],
)

stub(
    name = "sidecar_launcher",
    data = ["launcher_data"],
    sidecar = True,
)

windows_runner_toolchain(
    name = "sidecar_implementation",
    arch = "x86_64",
    backend = "wine",
    launcher = ":sidecar_launcher",
    loader = "loader",
    server = "server",
)

toolchain(
    name = "sidecar_runner",
    toolchain = ":sidecar_implementation",
    toolchain_type = "@rules_wine//wine:runner_x86_64_toolchain_type",
)

stub(name = "built_loader")

windows_runner_toolchain(
    name = "generated_implementation",
    arch = "x86_64",
    backend = "wine",
    launcher = ":launcher",
    loader = ":built_loader",
    server = "server",
)

toolchain(
    name = "generated_runner",
    toolchain = ":generated_implementation",
    toolchain_type = "@rules_wine//wine:runner_x86_64_toolchain_type",
)

windows_runner_toolchain(
    name = "implementation",
    arch = "x86_64",
    backend = "wine",
    launcher = ":launcher",
    loader = "loader",
    server = "server",
)

toolchain(
    name = "runner",
    toolchain = ":implementation",
    toolchain_type = "@rules_wine//wine:runner_x86_64_toolchain_type",
)

toolchain(
    name = "adapter",
    toolchain = ":implementation",
    toolchain_type = "@rules_wine//wine:adapter_x86_64_toolchain_type",
)

collision(
    name = "collision",
    binary = "payload.exe",
)

symlink_data(
    name = "alias_data",
    src = "only_via_alias",
)

stub(
    name = "payload_with_data",
    data = ["alias_data"],
)

windows_binary(
    name = "data_adapter",
    arch = "x86_64",
    binary = select({"//conditions:default": "payload_with_data"}),
)

windows_binary(
    name = "apparent_platform",
    arch = "x86_64",
    binary = "payload.exe",
    target_platform = "@rules_wine//platforms:windows_x86_64",
)

windows_binary(
    name = "wrong_platform",
    arch = "x86_64",
    binary = "payload.exe",
    target_platform = "audit_exec",
)

windows_binary(
    name = "wrong_cpu",
    arch = "x86_64",
    binary = "payload.exe",
    target_platform = "@rules_wine//platforms:windows_aarch64",
)
