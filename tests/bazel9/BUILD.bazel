load("//wine:windows_test.bzl", "windows_test")

# Bazel 9's default group selects Linux, while test explicitly selects Windows.
# aquery must show a PE launcher and a Windows test executor together.
windows_test(
    name = "native_group_test",
    arch = "x86_64",
    binary = "//tests:fixture/fixture_x86_64.exe",
    exec_group_compatible_with = {"test": [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ]},
    tags = ["manual"],
)

# Reverse mismatch: default selects Windows, actual test selects Linux/Wine.
windows_test(
    name = "wine_group_test",
    arch = "x86_64",
    binary = "//tests:fixture/fixture_x86_64.exe",
    exec_group_compatible_with = {"test": [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ]},
    tags = ["manual"],
)
